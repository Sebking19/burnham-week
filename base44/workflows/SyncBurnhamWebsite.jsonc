{
  "name": "Sync Burnham Week website",
  "description": "Refreshes the most out-of-date block of official Burnham Week website content every 15 minutes and notifies members when the race courses change",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_burnham_website",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_next_block": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncBurnhamSite",
            "args": {}
          },
          "then": "check_courses_changed",
          "x-base44": {
            "title": "Refresh website content",
            "description": "Oldest block first"
          }
        }
      },
      {
        "check_courses_changed": {
          "switch": [
            {
              "when": "${ (.sync_next_block.changed_keys // []) | index(\"courses\") != null }",
              "then": "notify_courses"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Courses changed?",
            "description": "Only notify when course content is new"
          }
        }
      },
      {
        "notify_courses": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendCoursesPush",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Notify members",
            "description": "Push notification about updated courses"
          }
        }
      }
    ]
  }
}