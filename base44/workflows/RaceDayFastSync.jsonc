{
  "name": "Race day fast sync",
  "description": "During Burnham Week race days, checks the race standings every 5 minutes from 9am to 11pm (automatically backing off when the website blocks requests) and notifies members when new results appear. Website content and course notifications are handled by the separate 15-minute sync.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 9-22 * 8,9 *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "on_date",
      "ends_on_date": "2026-09-06T23:00:00Z",
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "race_day_fast_sync",
      "version": "2.1",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_results": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncRaceResults",
            "args": {
              "limit": 6
            }
          },
          "then": "check_for_new_results",
          "x-base44": {
            "title": "Refresh race standings",
            "description": "Every 5 minutes; skips itself while the website is rate-limiting"
          }
        }
      },
      {
        "check_for_new_results": {
          "switch": [
            {
              "when": "${ (.sync_results.changed_count // 0) > 0 }",
              "then": "notify_results"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Anything new?",
            "description": "Only notify when standings actually changed"
          }
        }
      },
      {
        "notify_results": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendResultsPush",
            "args": {
              "classes": "${ .sync_results.changed_classes }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify members",
            "description": "Push notification about the new results"
          }
        }
      }
    ]
  }
}