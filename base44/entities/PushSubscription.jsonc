{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user subscribed to push notifications"
    },
    "endpoint": {
      "type": "string",
      "description": "Push subscription endpoint"
    },
    "p256dh": {
      "type": "string",
      "description": "P256DH public key"
    },
    "auth": {
      "type": "string",
      "description": "Auth secret"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether notifications are enabled for this subscription"
    }
  },
  "required": [
    "user_email",
    "endpoint",
    "p256dh",
    "auth"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    }
  }
}