{
  "name": "Post",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reactions": {
      "type": "object",
      "description": "Map of emoji to array of user emails who reacted"
    },
    "group": {
      "type": "string",
      "enum": [
        "pond",
        "river1",
        "river2",
        "race",
        "cadets",
        "fast",
        "all",
        "trainers"
      ],
      "default": "all"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        },
        {
          "user_condition": {
            "role": "chairman"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        },
        {
          "user_condition": {
            "role": "pond"
          }
        },
        {
          "user_condition": {
            "role": "river1"
          }
        },
        {
          "user_condition": {
            "role": "river2"
          }
        },
        {
          "user_condition": {
            "role": "race"
          }
        },
        {
          "user_condition": {
            "role": "cadets"
          }
        },
        {
          "user_condition": {
            "role": "fast"
          }
        },
        {
          "user_condition": {
            "role": "pond_trainer"
          }
        },
        {
          "user_condition": {
            "role": "river1_trainer"
          }
        },
        {
          "user_condition": {
            "role": "river2_trainer"
          }
        },
        {
          "user_condition": {
            "role": "race_trainer"
          }
        },
        {
          "user_condition": {
            "role": "cadet_trainer"
          }
        },
        {
          "user_condition": {
            "role": "fast_trainer"
          }
        }
      ]
    },
    "read": true,
    "update": true,
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        }
      ]
    }
  }
}