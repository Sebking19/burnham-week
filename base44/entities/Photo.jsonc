{
  "name": "Photo",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "uploader_name": {
      "type": "string"
    }
  },
  "required": [
    "image_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "owner"
      }
    },
    "read": {
      "user_condition": {
        "role": "owner"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        }
      ]
    }
  }
}