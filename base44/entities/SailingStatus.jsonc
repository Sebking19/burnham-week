{
  "name": "SailingStatus",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "The date this status applies to (YYYY-MM-DD)"
    },
    "status": {
      "type": "string",
      "enum": [
        "on",
        "caution",
        "off"
      ],
      "default": "on",
      "description": "Sailing status: on (green), caution (amber), off (red)"
    },
    "note": {
      "type": "string",
      "description": "Optional short note e.g. 'Strong gusts after 2pm'"
    },
    "set_by": {
      "type": "string",
      "description": "Name of the trainer/admin who set the status"
    }
  },
  "required": [
    "date",
    "status"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        },
        {
          "user_condition": {
            "role": "chairman"
          }
        },
        {
          "user_condition": {
            "role": "pond_trainer"
          }
        },
        {
          "user_condition": {
            "role": "river1_trainer"
          }
        },
        {
          "user_condition": {
            "role": "river2_trainer"
          }
        },
        {
          "user_condition": {
            "role": "race_trainer"
          }
        },
        {
          "user_condition": {
            "role": "cadet_trainer"
          }
        },
        {
          "user_condition": {
            "role": "fast_trainer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        },
        {
          "user_condition": {
            "role": "chairman"
          }
        },
        {
          "user_condition": {
            "role": "pond_trainer"
          }
        },
        {
          "user_condition": {
            "role": "river1_trainer"
          }
        },
        {
          "user_condition": {
            "role": "river2_trainer"
          }
        },
        {
          "user_condition": {
            "role": "race_trainer"
          }
        },
        {
          "user_condition": {
            "role": "cadet_trainer"
          }
        },
        {
          "user_condition": {
            "role": "fast_trainer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        }
      ]
    }
  }
}