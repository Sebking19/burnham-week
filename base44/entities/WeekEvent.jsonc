{
  "name": "WeekEvent",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Day of Burnham Week 2026 this event happens on"
    },
    "time": {
      "type": "string",
      "description": "Start time or time range, e.g. '10:00' or '15:00 - 20:00'"
    },
    "title": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "title"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}