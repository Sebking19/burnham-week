{
  "name": "Sponsor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Sponsor name"
    },
    "tagline": {
      "type": "string",
      "description": "Short punchy tagline"
    },
    "description": {
      "type": "string",
      "description": "Longer description of the sponsor"
    },
    "logo_url": {
      "type": "string",
      "description": "Main logo / photo URL"
    },
    "logo_3d": {
      "type": "boolean",
      "default": false,
      "description": "Show a 3D logo (uploaded model or auto-generated spinning coin)"
    },
    "model_url": {
      "type": "string",
      "description": "URL of uploaded 3D model file (.glb) for the 3D logo"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional photo URLs"
    },
    "website": {
      "type": "string",
      "description": "Main website URL"
    },
    "links": {
      "type": "array",
      "description": "Extra links (social pages etc)",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "place": {
      "type": "string",
      "description": "Location / place of the sponsor"
    },
    "accent_color": {
      "type": "string",
      "description": "Accent colour hex for the card"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order (lower first)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the sponsor is shown"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        },
        {
          "user_condition": {
            "role": "chairman"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        },
        {
          "user_condition": {
            "role": "chairman"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        },
        {
          "user_condition": {
            "role": "chairman"
          }
        }
      ]
    }
  }
}