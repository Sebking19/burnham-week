{
  "name": "DutyRoster",
  "type": "object",
  "properties": {
    "week_date": {
      "type": "string",
      "format": "date",
      "description": "The Saturday date this roster is for (YYYY-MM-DD)"
    },
    "assignments": {
      "type": "array",
      "description": "Array of role assignments for this week",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional notes for the week"
    }
  },
  "required": [
    "week_date"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        },
        {
          "user_condition": {
            "role": "chairman"
          }
        },
        {
          "user_condition": {
            "role": "pond_trainer"
          }
        },
        {
          "user_condition": {
            "role": "river1_trainer"
          }
        },
        {
          "user_condition": {
            "role": "river2_trainer"
          }
        },
        {
          "user_condition": {
            "role": "race_trainer"
          }
        },
        {
          "user_condition": {
            "role": "cadet_trainer"
          }
        },
        {
          "user_condition": {
            "role": "fast_trainer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        },
        {
          "user_condition": {
            "role": "chairman"
          }
        },
        {
          "user_condition": {
            "role": "pond_trainer"
          }
        },
        {
          "user_condition": {
            "role": "river1_trainer"
          }
        },
        {
          "user_condition": {
            "role": "river2_trainer"
          }
        },
        {
          "user_condition": {
            "role": "race_trainer"
          }
        },
        {
          "user_condition": {
            "role": "cadet_trainer"
          }
        },
        {
          "user_condition": {
            "role": "fast_trainer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        }
      ]
    }
  }
}