{
  "name": "SailingCancellation",
  "type": "object",
  "properties": {
    "boat_name": {
      "type": "string",
      "description": "Name of the boat class cancelled"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the cancellation (YYYY-MM-DD)"
    },
    "reason": {
      "type": "string",
      "description": "Reason for cancellation e.g. wind too strong"
    },
    "cancelled_by": {
      "type": "string",
      "description": "Name of the person who cancelled"
    }
  },
  "required": [
    "boat_name",
    "date"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admiral"
          }
        },
        {
          "user_condition": {
            "role": "chairman"
          }
        },
        {
