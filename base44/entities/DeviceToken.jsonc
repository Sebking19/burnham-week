{
  "name": "DeviceToken",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "FCM registration token from the device"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the app user this device belongs to"
    },
    "platform": {
      "type": "string",
      "enum": [
        "ios",
        "android"
      ],
      "default": "ios",
      "description": "Device platform"
    },
    "last_registered_at": {
      "type": "string",
      "description": "ISO timestamp of the last registration/refresh"
    }
  },
  "required": [
    "token"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}